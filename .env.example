# PORT: Port where the backend server runs (default: 3000)
PORT=3000

# ADMIN_PASSWORD: Password to access the VIP Salon store administration panel (/admin)
ADMIN_PASSWORD="vipadmin2026"

# STRIPE CONFIGURATION (Optional for real card payments; if omitted, test card simulation is used)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."

# SMTP EMAIL CONFIGURATION (Optional for live email sending; if omitted, simulated to server logs)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="boutique@vipbeautyhouse.bg"
SMTP_PASS="your_smtp_app_password"
SALON_EMAIL="contact@vipbeautyhouse.bg"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
