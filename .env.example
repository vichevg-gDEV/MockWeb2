# Copy this file to ".env" on the server (".env" is git-ignored and must never be committed).
# Everything is optional - the server works with no .env at all.

# Where the server listens. Keep 127.0.0.1 when a reverse proxy (Caddy/nginx) sits in front,
# use 0.0.0.0 only if the server is reached directly.
PORT=8080
HOST=127.0.0.1

# Set to 1 when running behind a reverse proxy, so limits use the visitor's real IP.
TRUST_PROXY=0

# Admin passcode, used ONLY the first time the server starts (min. 8 characters).
# Leave empty and the server generates a random one and prints it once in the console.
# After that, change it in the admin panel (Settings) or with: npm run set-pin
ADMIN_PASSWORD=

# --- Get a message on your phone for every new order and booking (pick any, or none) ---
# Telegram: create a bot with @BotFather, send it a message, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates  to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Or a webhook: an ntfy.sh topic URL (https://ntfy.sh/your-secret-topic), a Discord or Slack webhook.
NOTIFY_WEBHOOK_URL=

# Delivery pricing used when an order is created (lv.)
SHIPPING_FEE=7
FREE_SHIPPING_OVER=150

# Bookings are accepted only between these times
BOOKING_OPEN=10:00
BOOKING_CLOSE=19:00
